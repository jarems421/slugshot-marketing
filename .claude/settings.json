{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content .\\.env)",
      "PowerShell(type .env)",
      "Bash(npx clip *)",
      "Bash(npx --no-install clip *)",
      "Bash(npx @makemyclip/editor *)",
      "Bash(npx -y @makemyclip/editor *)",
      "Bash(npm run clip *)",
      "Bash(node node_modules/@makemyclip/*)",
      "Bash(node ./node_modules/@makemyclip/*)",
      "Bash(node_modules/.bin/clip *)",
      "PowerShell(npx clip *)",
      "PowerShell(npx.cmd clip *)",
      "PowerShell(npx --no-install clip *)",
      "PowerShell(npx.cmd --no-install clip *)",
      "PowerShell(npx @makemyclip/editor *)",
      "PowerShell(npx -y @makemyclip/editor *)",
      "PowerShell(npm run clip *)",
      "PowerShell(npm.cmd run clip *)",
      "PowerShell(node node_modules/@makemyclip/*)",
      "PowerShell(node node_modules\\@makemyclip\\*)",
      "PowerShell(node_modules\\.bin\\clip *)",
      "Bash(*StudioMCP*)",
      "Bash(*mcp.bat*)",
      "PowerShell(*StudioMCP*)",
      "PowerShell(*mcp.bat*)"
    ],
    "ask": [
      "Edit(./.env)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",
      "mcp__Roblox_Studio__insert_asset",
      "mcp__Roblox_Studio__upload_image",
      "mcp__Roblox_Studio__open_cloud_invoke",
      "mcp__Roblox_Studio__generate_mesh",
      "mcp__Roblox_Studio__generate_material",
      "mcp__Roblox_Studio__generate_procedural_model",
      "mcp__Roblox_Studio__generate_texture",
      "mcp__Roblox_Studio__generate_scene",
      "mcp__Roblox_Studio__generate_avatar",
      "mcp__Roblox_Studio__generate_animation",
      "mcp__Roblox_Studio__auto_setup_avatar",
      "mcp__Roblox_Studio__segment_mesh",
      "mcp__Roblox_Studio__subagent",
      "mcp__Roblox_Studio__create_skill",
      "mcp__Roblox_Studio__edit_skill"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Roblox_Studio__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/roblox-native/tools/studio_guard.py\"",
            "timeout": 40,
            "onFailure": "block",
            "statusMessage": "Checking the Studio target is the marketing place..."
          }
        ]
      }
    ]
  }
}
