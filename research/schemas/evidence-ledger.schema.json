{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:slugshot:evidence-ledger:1.0",
 "title": "Slugshot evidence ledger",
 "description": "Shared by Claude (scripts/evidence.py validates it) and ChatGPT (Research Evidence skill). Support statuses, evidence roles, access statuses and finding types follow EvidenceGuard V0.1 (MIT, research/upstream/evidenceguard). Structural validity does not certify truth.",
 "type": "object",
 "required": ["ledger_version", "ledger_id", "decision", "evidence", "claims"],
 "properties": {
  "ledger_version": {"const": "slugshot-evidence-1.0"},
  "ledger_id": {"type": "string", "minLength": 1},
  "created_at": {"type": "string"},
  "updated_at": {"type": "string"},
  "decision": {"type": "object", "required": ["decision_id", "question"], "properties": {
   "decision_id": {"type": "string"}, "question": {"type": "string"}, "decision_threshold": {"type": "string"},
   "owner_decision": {"type": "string"}}},
  "contract": {"type": "object", "description": "Research contract: primary_question, construct, not_evidence[], markets[], languages[], platforms[], time_window, hypotheses[], rival_hypotheses[], negative_controls[], sampling_plan, stop_rule"},
  "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
  "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
  "decision_memo": {"type": "object", "description": "recommend, supported_findings[], uncertain_but_useful[], counterevidence[], unknown[], creative_hypothesis, cheapest_test"},
  "summary": {"type": "object", "description": "Computed by `ss evidence validate --fix-summary`"},
  "limitations": {"type": "array", "items": {"type": "string"}}
 },
 "$defs": {
  "evidence": {
   "type": "object",
   "required": ["evidence_id", "source_family", "actual_role", "provenance", "locator"],
   "properties": {
    "evidence_id": {"type": "string"},
    "description": {"type": "string"},
    "source_family": {"enum": ["youtube", "tiktok", "instagram", "twitch", "roblox", "google_search", "wikimedia", "news", "literature",
                               "owned_experiment", "qualitative_review", "community_reference", "other"],
                      "description": "The data-generating process. Several tools relaying one platform's number are one family."},
    "actual_role": {"enum": ["observed_result", "estimate", "forecast", "target", "definition", "requirement", "expert_opinion",
                             "contextual_background", "method_or_design", "other", "platform_metric", "third_party_estimate",
                             "normalised_index", "qualitative_coding", "experiment_result", "literature_finding", "search_record"]},
    "provenance": {"enum": ["P1", "P2", "P3", "P4"]},
    "access_status": {"enum": ["full", "partial", "metadata_only", "inaccessible"]},
    "item": {"type": "string", "description": "stable item key (e.g. tiktok:hashtag:huss, a video_id); lets the validator find repeated observations of the same thing"},
    "item_type": {"enum": ["post", "video", "clip", "hashtag", "sound", "keyword", "search_term", "creator", "article", "game", "series", "other"]},
    "metric": {"type": "string"},
    "observed_at": {"type": "string"},
    "series_points": {"type": "integer", "description": "number of dated points when one item of evidence is a time series"},
    "scope": {"type": "object", "description": "region, period, category, query, region_param, relevance_language_param, language_edition, search_geo, source_filter"},
    "metric_definition": {"enum": ["verified", "approximate", "unknown"]},
    "sample_role": {"enum": ["featured", "ordinary", "failed", "counterexample", "unknown"]},
    "expires_at": {"type": "string", "description": "provider retention for the cited data (YouTube 30 days, Twitch 24 h)"},
    "locator": {"type": "object", "description": "file + where{col: val} + column + value (bundle row), or source_path + quote (exact passage), or url, or note",
                "properties": {"file": {"type": "string"}, "where": {"type": "object"}, "column": {"type": "string"},
                               "value": {"type": ["string", "number"]}, "source_path": {"type": "string"}, "quote": {"type": "string"},
                               "url": {"type": "string"}, "note": {"type": "string"}}}
   }
  },
  "claim": {
   "type": "object",
   "required": ["claim_id", "claim_text", "level", "support_status", "strength", "evidence_refs"],
   "properties": {
    "claim_id": {"type": "string"},
    "decision_id": {"type": "string"},
    "claim_text": {"type": "string", "description": "exact bounded wording; one atomic proposition"},
    "level": {"enum": ["O", "D", "P", "I", "C", "R"], "description": "observation, derived statistic, descriptive pattern, interpretation, causal claim, recommendation"},
    "construct": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "description": "evidence_ids or earlier claim_ids"},
    "counterevidence_refs": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": ["string", "object"]},
    "sample_design": {"type": "string"},
    "metric_definition": {"type": "string"},
    "missingness": {"type": ["string", "array"]},
    "rival_hypotheses": {"type": "array", "items": {"type": "string"}},
    "independence_notes": {"type": "string"},
    "analysis_spec": {"type": "string"},
    "values": {"type": "object", "description": "numbers used in the claim text, for traceability"},
    "support_status": {"enum": ["supported", "partially_supported", "unsupported", "indeterminate"]},
    "strength": {"enum": ["exploratory", "suggestive", "supported_descriptive", "convergent", "experimental"]},
    "dimensions": {"type": "object", "description": "directness, coverage, temporal, independence, robustness, counterevidence: {rating: strong|adequate|weak|none|unknown, note}"},
    "causal_basis": {"type": "string", "description": "required for level C without owned experiment evidence: design and assumptions"},
    "next_discriminating_test": {"type": "string"},
    "experiment": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object", "required": ["finding_id", "type", "severity"], "properties": {
     "finding_id": {"type": "string"},
     "type": {"enum": ["unsupported_factual_claim", "partial_support", "citation_role_mismatch", "stale_or_insufficient_source",
                       "causal_overclaim", "numeric_inconsistency", "unclear_population_or_timeframe"]},
     "severity": {"enum": ["error", "warning", "info"]}, "explanation": {"type": "string"},
     "evidence_basis": {"type": "string"}, "remediation": {"type": "string"}}}},
    "review": {"type": "object", "description": "{ai_reviewed: bool, reviewer: claude|chatgpt|owner, notes}"}
   }
  }
 }
}
