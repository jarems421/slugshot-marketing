# Copy to .env (git-ignored) and fill in locally. Never paste the real key into chat.
# Create it in Google Cloud Console > APIs & Services > Credentials, restricted to "YouTube Data API v3".
YOUTUBE_API_KEY=
# Twitch app credentials (dev.twitch.tv/console > Register Your Application; see docs/research-data.md). Never paste real values into chat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Composio project API key (Composio dashboard > Settings > API keys). Hobby plan: free and hard-capped. Never paste real values into chat.
COMPOSIO_API_KEY=
# Dashboard (docs/dashboard/credentials-checklist.md). These can also be pasted into the dashboard's Settings page, which stores them encrypted (Windows DPAPI).
# Google Cloud > Google Auth Platform > Clients > Desktop app (same project as the Data API key; enable YouTube Analytics API).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# TikTok for Developers app with Login Kit + Display API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Roblox Open Cloud API key with universe-analytics: universe.analytics:read for the Slugshot experience.
ROBLOX_ANALYTICS_API_KEY=
# Buffer personal API key (publish.buffer.com > Settings > API). Free plan: 3,000 requests per 30 days, 31 days of insights. Keys expire (7 days to 1 year).
BUFFER_API_KEY=
# Cloudinary (free plan): hosts approved videos briefly for Buffer. Cloud name is on the Console dashboard (lowercase), not the account or key name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini TTS (ss dialogue --engine gemini); spending guard in config/voice-budget.json
GEMINI_API_KEY=
