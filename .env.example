# Copy to .env (git-ignored) and fill in locally. Never paste the real key into chat.
# Create it in Google Cloud Console > APIs & Services > Credentials, restricted to "YouTube Data API v3".
YOUTUBE_API_KEY=
# Twitch app credentials (dev.twitch.tv/console > Register Your Application; see docs/research-data.md). Never paste real values into chat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
